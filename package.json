{
  "name": "iam-group-sync",
  "version": "1.0.0",
  "description": "Syncs Microsoft Entra ID security groups from Microsoft Graph into MongoDB and serves them over a REST API.",
  "main": "dist/server.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "docker compose up -d --wait",
    "dev": "tsx watch src/server.ts",
    "teardown": "docker compose down",
    "reset": "docker compose down -v",
    "docker:build": "docker build -t iam-group-sync .",
    "docker:run": "docker run --rm --name iam-app -p 3000:3000 --env-file .env --add-host=host.docker.internal:host-gateway -e MONGODB_URI=mongodb://host.docker.internal:27018/iam iam-group-sync",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "graph:check": "tsx scripts/graph-check.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@azure/identity": "^4.14.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.4",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
