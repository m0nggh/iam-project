# Copy this file to .env and fill in the values. .env is git-ignored – never commit secrets.

# ---- Graph mode --------------------------------------------------------------
# live = call the real Microsoft Graph API (needs the three Azure values below)
# mock = use bundled sample data, no Azure account needed
# If unset: live when TENANT_ID is set, otherwise mock.
# Starts as mock so a fresh copy works immediately; switch to live once the values below are filled in.
GRAPH_MODE=mock

# ---- Entra ID app registration (needed for GRAPH_MODE=live) -----------------
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# ---- MongoDB -------------------------------------------------------------------
# Points at the MongoDB container started by `npm run setup` (or use an Atlas URI instead).
# 127.0.0.1:27018 on purpose – see docker-compose.yml.
MONGODB_URI=mongodb://127.0.0.1:27018/iam

# ---- Optional --------------------------------------------------------------------
PORT=3000
LOG_LEVEL=info
# Mock mode only: simulate a Graph failure (401, 403 or 429) to see the error handling.
# MOCK_GRAPH_FAIL=429
